{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "auto",
    "color": {
      "1": "cyan"
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "cyan",
      "title": "cyan"
    },
    "size": {
      "ndigits": 2
    },
    "percent": {
      "type": 9
    },
    "bar": {
      "char": {
        "elapsed": "-",
        "total": "="
      },
      "width": 15
    }
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "\u001b[37m┌───────────────────────────────┐"
    },
    {
      "type": "custom",
      "format": "\u001b[37m​ Operating System"
    },
    {
      "type": "os",
      "key": "​ ​​ ​  >"
    },
    {
      "type": "wm",
      "key": "​ ​​ ​  >"
    },
    {
      "type": "terminal",
      "key": "​​​ ​ ​  >"
    },
    {
      "type": "shell",
      "key": "​ ​ ​  >",
      "format": "{1}"
    },
    {
      "type": "kernel",
      "key": "​ ​ ​  >",
      "format": "{1}"
    },
    {
      "type": "packages",
      "key": "​ ​ ​  >"
    },
    {
      "type": "custom",
      "format": "\u001b[37m​ Hardware"
    },
    {
      "type": "cpu",
      "key": "​ ​​ ​ 󰍛 >",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "​ ​​ ​  >",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": "​ ​​ ​ 󰑭>"
    },
    {
      "type": "display",
      "key": "​ ​​ ​ 󰍹 >",
      "format": "{1} @ {2}Hz"
    },
    {
      "type": "custom",
      "format": "\u001b[37m​ ETC"
    },
    {
      "type": "sound",
      "key": "​ ​​ ​ 󰝚 >"
    },
    {
      "type": "disk",
      "key": "​ ​​ ​ 󰋊 >",
      "path": "/"
    },
    {
      "type": "custom",
      "format": "\u001b[37m└───────────────────────────────┘"
    }
  ]
}
